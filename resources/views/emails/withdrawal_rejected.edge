<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Withdrawal Not Approved — Phoenix-Capital</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Sora:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Sora', sans-serif;
      background-color: #0a0e14;
      padding: 40px 16px;
    }

    .wrapper {
      max-width: 560px;
      margin: 0 auto;
    }

    .logo-bar {
      text-align: center;
      padding-bottom: 28px;
    }
    .logo-bar span {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #ff5f5f;
    }

    .card {
      background: #111821;
      border: 1px solid #1e2d3d;
      border-radius: 20px;
      overflow: hidden;
    }

    /* ── Hero ── */
    .hero {
      padding: 48px 40px 36px;
      text-align: center;
      background: linear-gradient(160deg, #1f0d0d 0%, #111821 100%);
      border-bottom: 1px solid #1e2d3d;
      position: relative;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: -60px; left: 50%;
      transform: translateX(-50%);
      width: 240px; height: 240px;
      background: radial-gradient(circle, rgba(255,95,95,0.1) 0%, transparent 70%);
      pointer-events: none;
    }
    .alert-ring {
      width: 72px; height: 72px;
      border-radius: 50%;
      border: 2px solid rgba(255,95,95,0.4);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 20px;
      background: rgba(255,95,95,0.06);
      position: relative;
    }
    .alert-ring::after {
      content: '';
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      border: 1px solid rgba(255,95,95,0.15);
    }
    .alert-ring svg { width: 30px; height: 30px; }
    .hero h1 {
      font-size: 22px;
      font-weight: 700;
      color: #f0f6ff;
      letter-spacing: -0.3px;
      margin-bottom: 8px;
    }
    .hero p {
      font-size: 14px;
      color: #607080;
      font-weight: 300;
    }

    /* ── Body ── */
    .body {
      padding: 32px 40px;
    }
    .greeting {
      font-size: 14px;
      color: #8a9ab0;
      margin-bottom: 24px;
      line-height: 1.7;
    }
    .greeting strong {
      color: #d0e0f0;
      font-weight: 600;
    }

    /* ── Amount pill ── */
    .amount-block {
      background: linear-gradient(135deg, #1f0d0d, #0d1a2e);
      border: 1px solid rgba(255,95,95,0.2);
      border-radius: 14px;
      padding: 20px 24px;
      text-align: center;
      margin-bottom: 24px;
    }
    .amount-label {
      font-size: 11px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: #ff5f5f;
      opacity: 0.7;
      margin-bottom: 8px;
    }
    .amount-value {
      font-size: 32px;
      font-weight: 700;
      color: #ff5f5f;
      letter-spacing: -1px;
      line-height: 1;
    }
    .amount-value span {
      font-size: 16px;
      font-weight: 400;
      opacity: 0.6;
      margin-left: 4px;
    }

    /* ── Reason box ── */
    .reason-box {
      background: rgba(255,95,95,0.04);
      border: 1px solid rgba(255,95,95,0.18);
      border-left: 3px solid #ff5f5f;
      border-radius: 10px;
      padding: 18px 20px;
      margin-bottom: 24px;
    }
    .reason-label {
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #ff5f5f;
      opacity: 0.7;
      margin-bottom: 8px;
      display: block;
    }
    .reason-text {
      font-size: 14px;
      color: #c8d8e8;
      line-height: 1.6;
      font-style: italic;
    }

    /* ── Info card ── */
    .info-card {
      background: rgba(78,255,176,0.04);
      border: 1px solid rgba(78,255,176,0.15);
      border-radius: 10px;
      padding: 16px 20px;
      margin-bottom: 24px;
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }
    .info-icon {
      width: 32px; height: 32px;
      border-radius: 50%;
      background: rgba(78,255,176,0.08);
      border: 1px solid rgba(78,255,176,0.2);
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0;
      margin-top: 1px;
    }
    .info-icon svg { width: 16px; height: 16px; }
    .info-text {
      font-size: 13px;
      color: #8a9ab0;
      line-height: 1.65;
    }
    .info-text strong {
      color: #4fffb0;
      font-weight: 600;
    }

    /* ── Note ── */
    .note {
      font-size: 13px;
      color: #506070;
      line-height: 1.7;
      text-align: center;
      margin-bottom: 28px;
    }

    /* ── Support button ── */
    .support-btn {
      display: block;
      text-align: center;
      padding: 13px 24px;
      background: transparent;
      border: 1px solid #1e2d3d;
      border-radius: 10px;
      color: #8a9ab0;
      text-decoration: none;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.3px;
      margin-bottom: 28px;
      transition: border-color 0.2s, color 0.2s;
    }

    /* ── Signature ── */
    .signature {
      text-align: center;
      padding-top: 24px;
      border-top: 1px solid #1a2535;
    }
    .signature p {
      font-size: 13px;
      color: #607888;
    }
    .signature strong {
      color: #ff5f5f;
      font-weight: 600;
    }

    /* ── Footer ── */
    .footer {
      padding: 20px 40px 28px;
      text-align: center;
      background: #0d1420;
      border-top: 1px solid #1a2535;
    }
    .footer p {
      font-size: 11px;
      color: #3a4e60;
      line-height: 1.8;
      letter-spacing: 0.2px;
    }
    .footer .copy {
      color: #2a3e50;
      margin-top: 4px;
    }
  </style>
</head>
<body>

<div class="wrapper">

  <div class="logo-bar">
    <span>Phoenix-Capital</span>
  </div>

  <div class="card">

    <!-- Hero -->
    <div class="hero">
      <div class="alert-ring">
        <svg viewBox="0 0 24 24" fill="none" stroke="#ff5f5f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="8" x2="12" y2="12"/>
          <line x1="12" y1="16" x2="12.01" y2="16"/>
          <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
        </svg>
      </div>
      <h1>Withdrawal Not Approved</h1>
      <p>Your request could not be completed at this time.</p>
    </div>

    <!-- Body -->
    <div class="body">

      <p class="greeting">
        Hello <strong>{{ user.fullName }}</strong>,<br>
        We're letting you know that your withdrawal request of <strong>{{ amount }} USDT</strong> could not be finalized.
      </p>

      <!-- Reason -->
      <div class="reason-box">
        <span class="reason-label">Reason for rejection</span>
        <span class="reason-text">{{ reason }}</span>
      </div>

      <!-- Refund info -->
      <div class="info-card">
        <div class="info-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="#4fffb0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="23 4 23 10 17 10"/>
            <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
          </svg>
        </div>
        <p class="info-text">
          <strong>Good news:</strong> The full amount along with any withdrawal fees have been returned to your <strong>Phoenix capital</strong> balance.
        </p>
      </div>

      <p class="note">
        If you believe this is an error or need help submitting a new request,<br>our support team is ready to assist you.
      </p>

      <a href="#" class="support-btn">Contact Support</a>

      <div class="signature">
        <p>Best regards,</p>
        <p><strong>The Phoenix-Capital Team</strong></p>
      </div>

    </div>

    <!-- Footer -->
    <div class="footer">
      <p>This is an automated security message — please do not reply.</p>
      <p class="copy">&copy; 2026 Phoenix-capital. Keep your assets secure.</p>
    </div>

  </div>

</div>

</body>
</html>