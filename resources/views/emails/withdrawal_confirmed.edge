<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Withdrawal Confirmed — Thrive</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Sora:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'Sora', sans-serif;
      background-color: #0a0e14;
      padding: 40px 16px;
    }

    .wrapper {
      max-width: 560px;
      margin: 0 auto;
    }

    /* ── Logo bar ── */
    .logo-bar {
      text-align: center;
      padding-bottom: 28px;
    }
    .logo-bar span {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #4fffb0;
    }

    /* ── Card ── */
    .card {
      background: #111821;
      border: 1px solid #1e2d3d;
      border-radius: 20px;
      overflow: hidden;
    }

    /* ── Hero ── */
    .hero {
      padding: 48px 40px 36px;
      text-align: center;
      background: linear-gradient(160deg, #0d1f2e 0%, #111821 100%);
      border-bottom: 1px solid #1e2d3d;
      position: relative;
    }
    .hero::before {
      content: '';
      position: absolute;
      top: -60px; left: 50%;
      transform: translateX(-50%);
      width: 240px; height: 240px;
      background: radial-gradient(circle, rgba(78,255,176,0.12) 0%, transparent 70%);
      pointer-events: none;
    }
    .check-ring {
      width: 72px; height: 72px;
      border-radius: 50%;
      border: 2px solid rgba(78,255,176,0.4);
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 20px;
      background: rgba(78,255,176,0.06);
      position: relative;
    }
    .check-ring::after {
      content: '';
      position: absolute;
      inset: -6px;
      border-radius: 50%;
      border: 1px solid rgba(78,255,176,0.15);
    }
    .check-ring svg { width: 32px; height: 32px; }
    .hero h1 {
      font-size: 22px;
      font-weight: 700;
      color: #f0f6ff;
      letter-spacing: -0.3px;
      margin-bottom: 8px;
    }
    .hero p {
      font-size: 14px;
      color: #607080;
      font-weight: 300;
    }

    /* ── Body ── */
    .body {
      padding: 32px 40px;
    }
    .greeting {
      font-size: 14px;
      color: #8a9ab0;
      margin-bottom: 24px;
      line-height: 1.7;
    }
    .greeting strong {
      color: #d0e0f0;
      font-weight: 600;
    }

    /* ── Amount pill ── */
    .amount-block {
      background: linear-gradient(135deg, #0d2418, #0d1a2e);
      border: 1px solid rgba(78,255,176,0.2);
      border-radius: 14px;
      padding: 24px;
      text-align: center;
      margin-bottom: 28px;
    }
    .amount-label {
      font-size: 11px;
      letter-spacing: 2.5px;
      text-transform: uppercase;
      color: #4fffb0;
      opacity: 0.7;
      margin-bottom: 8px;
    }
    .amount-value {
      font-size: 36px;
      font-weight: 700;
      color: #4fffb0;
      letter-spacing: -1px;
      line-height: 1;
    }
    .amount-value span {
      font-size: 18px;
      font-weight: 400;
      opacity: 0.6;
      margin-left: 4px;
    }

    /* ── Details ── */
    .details {
      border-top: 1px solid #1a2535;
      padding-top: 20px;
    }
    .detail-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      padding: 14px 0;
      border-bottom: 1px solid #141e2a;
      gap: 16px;
    }
    .detail-row:last-child { border-bottom: none; }
    .detail-label {
      font-size: 12px;
      color: #506070;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 500;
      white-space: nowrap;
      padding-top: 2px;
    }
    .detail-value {
      font-size: 13px;
      color: #c8d8e8;
      font-weight: 600;
      text-align: right;
    }
    .detail-value.mono {
      font-family: 'DM Mono', monospace;
      font-size: 11px;
      color: #8aaac8;
      word-break: break-all;
    }

    /* ── Note ── */
    .note {
      margin-top: 24px;
      font-size: 13px;
      color: #506070;
      line-height: 1.7;
      text-align: center;
    }

    /* ── Signature ── */
    .signature {
      margin-top: 28px;
      text-align: center;
      padding-top: 24px;
      border-top: 1px solid #1a2535;
    }
    .signature p {
      font-size: 13px;
      color: #607888;
    }
    .signature strong {
      color: #4fffb0;
      font-weight: 600;
    }

    /* ── Footer ── */
    .footer {
      padding: 20px 40px 28px;
      text-align: center;
      background: #0d1420;
      border-top: 1px solid #1a2535;
    }
    .footer p {
      font-size: 11px;
      color: #3a4e60;
      line-height: 1.8;
      letter-spacing: 0.2px;
    }
    .footer .copy {
      color: #2a3e50;
      margin-top: 4px;
    }
  </style>
</head>
<body>

<div class="wrapper">

  <div class="logo-bar">
    <span>Thrive</span>
  </div>

  <div class="card">

    <!-- Hero -->
    <div class="hero">
      <div class="check-ring">
        <svg viewBox="0 0 24 24" fill="none" stroke="#4fffb0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="20 6 9 17 4 12"/>
        </svg>
      </div>
      <h1>Withdrawal Successful</h1>
      <p>Your transaction has been processed and broadcast to the network.</p>
    </div>

    <!-- Body -->
    <div class="body">

      <p class="greeting">
        Hello <strong>{{ user.fullName }}</strong>,<br>
        We confirm that your withdrawal request has been successfully processed by our system.
      </p>

      <!-- Amount -->
      <div class="amount-block">
        <div class="amount-label">Amount Sent</div>
        <div class="amount-value">{{ amount }}<span>USDT</span></div>
      </div>

      <!-- Details -->
      <div class="details">
        <div class="detail-row">
          <span class="detail-label">Network</span>
          <span class="detail-value">{{ network }}</span>
        </div>
        <div class="detail-row">
          <span class="detail-label">TXID</span>
          <span class="detail-value mono">{{ txid }}</span>
        </div>
      </div>

      <p class="note">
        You can track your transaction in real time on the block explorer of your network.
      </p>

      <div class="signature">
        <p>Thank you for your trust.</p>
        <p><strong>The Thrive Team</strong></p>
      </div>

    </div>

    <!-- Footer -->
    <div class="footer">
      <p>This is an automated message — please do not reply.</p>
      <p class="copy">&copy; 2026 Thrive. All rights reserved.</p>
    </div>

  </div>

</div>

</body>
</html>